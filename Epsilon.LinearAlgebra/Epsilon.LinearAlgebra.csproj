<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships the /// docs with the package so IntelliSense shows them to library users. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Experimental: not published until its API is stabilized like Epsilon.Core. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup> 
    <ProjectReference Include="..\Epsilon.Core\Epsilon.Core.csproj" /> 
  </ItemGroup>

</Project>
