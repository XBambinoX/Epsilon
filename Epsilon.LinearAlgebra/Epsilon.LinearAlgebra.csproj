<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships the /// docs with the package so IntelliSense shows them to library users. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package. It depends on the Epsilon package at the <Version> of Epsilon.Core.csproj,
       so the core's csproj must name a released version with everything this project uses. -->
  <PropertyGroup>
    <PackageId>Epsilon.LinearAlgebra</PackageId>
    <!-- Not passed as -p:Version when packing: a global Version would reach the core project
         too and make the dependency "Epsilon >= this version". publish.yml checks the tag
         against it instead. -->
    <Version>1.4.0</Version>
    <Authors>Max Zakharov</Authors>
    <Description>Linear algebra for the Epsilon symbolic math library: immutable matrices and vectors of expressions, exact rationals or doubles, and fixed-size vector and matrix value types (Vector2 to Vector4, Matrix2x2 to Matrix4x4) of float, double or any number type for games and graphics. Exact symbolic determinant, characteristic polynomial, inverse and solve without division; exact rational elimination; LU decomposition for doubles with singularity detection to working precision. Vector geometry, transforms, quaternions with slerp, Euler angles in any axis order, translation-rotation-scale decomposition, camera view and projection matrices (right- and left-handed, any depth range, reverse-Z), a closed-form inverse that detects singular matrices, conversions to System.Numerics, blocks, ranges, powers and approximate equality. Symbolic formulas become fast code: matrices and vectors of expressions compile to delegates with exactly the values of Evaluate or to standalone C# source, with Jacobians and symbolic rotations and translations for kinematic chains and inverse kinematics.</Description>
    <PackageTags>math;symbolic;cas;computer-algebra;linear-algebra;matrix;vector;determinant;inverse;eigenvalues;rational;exact;cross-product;latex;gamedev;graphics;vector3;matrix4x4;transform;rotation;quaternion;slerp;euler-angles;camera;projection;jacobian;kinematics;inverse-kinematics;compile;code-generation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/XBambinoX/Epsilon</PackageProjectUrl>
    <RepositoryUrl>https://github.com/XBambinoX/Epsilon</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Symbols (.snupkg) and Source Link, so users can step into the library's source. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Epsilon.Core\Epsilon.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests check what the debugger shows, which is internal. -->
    <InternalsVisibleTo Include="Epsilon.Tests" />
  </ItemGroup>

</Project>
