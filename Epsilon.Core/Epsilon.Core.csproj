<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships the /// docs with the package so IntelliSense shows them to library users. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Collections.Immutable" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests drive internals that the public API can't reach, e.g. a rule cycle in Simplify. -->
    <InternalsVisibleTo Include="Epsilon.Tests" />
  </ItemGroup>

</Project>
